    "hotkey.tapCreationFailed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht auf die Tastenkombination hören. Erteile Plainsay Zugriff in Systemeinstellungen › Datenschutz & Sicherheit › Input Monitoring und starte es dann neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not listen for the hotkey. Grant Plainsay access in System Settings › Privacy & Security › Input Monitoring, then restart it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo escuchar el atajo. Concede acceso a Plainsay en Ajustes del sistema › Privacidad y seguridad › Monitorización de entrada, y luego reinícialo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'écouter le raccourci. Autorisez Plainsay dans Réglages Système › Confidentialité et sécurité › Surveillance des saisies, puis redémarrez l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile ascoltare la scorciatoia. Concedi l'accesso a Plainsay in Impostazioni di sistema › Privacy e sicurezza › Monitoraggio input, poi riavvialo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホットキーを監視できませんでした。システム設定 › プライバシーとセキュリティ › 入力監視でPlainsayにアクセスを許可し、再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 감지할 수 없었습니다. 시스템 설정 › 개인정보 보호 및 보안 › 입력 모니터링에서 Plainsay에 접근을 허용한 후 다시 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon niet naar de sneltoets luisteren. Geef Plainsay toegang in Systeeminstellingen › Privacy en beveiliging › Invoermonitoring, en start het opnieuw op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można nasłuchiwać skrótu. Przyznaj Plainsay dostęp w Ustawieniach systemowych › Prywatność i ochrona › Monitorowanie wejścia, a następnie uruchom ją ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível escutar o atalho. Concede acesso ao Plainsay em Definições do sistema › Privacidade e Segurança › Monitorização de Entrada, e depois reinicia-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать отслеживание клавиши. Предоставьте Plainsay доступ в Системных настройках › Конфиденциальность и безопасность › Мониторинг ввода, затем перезапустите приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося почати відстеження клавіші. Надайте Plainsay доступ у Системних налаштуваннях › Конфіденційність і безпека › Моніторинг вводу, потім перезапустіть застосунок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法监听快捷键。请在「系统设置 › 隐私与安全性 › 输入监control」中为 Plainsay 授权，然后重新启动应用。"
          }
        }
      }
    },
