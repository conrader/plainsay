{
  "sourceLanguage": "en",
  "strings": {
    "asrProvider.cost.deapi": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "~0,021 $/Stunde Audio · 5 $ Startguthaben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "~$0.021/hour of audio · $5 free credit to start"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "~0,021 $/hora de audio · 5 $ de crédito gratis para empezar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "~0,021 $/heure d'audio · 5 $ de crédit offert au départ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "~0,021 $/ora di audio · 5 $ di credito gratuito iniziale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声1時間あたり約0.021ドル · 開始時に5ドル分の無料クレジット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 1시간당 약 0.021달러 · 시작 시 5달러 무료 크레딧"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "~$0,021/uur audio · $5 gratis tegoed om te beginnen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "~0,021 USD/godzinę audio · 5 USD kredytu na start"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "~0,021 $/hora de áudio · 5 $ de crédito grátis para começar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "~0,021 $/час аудио · 5 $ бесплатно на старте"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "~0,021 $/годину аудіо · 5 $ безкоштовно на старті"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 0.021 美元/小时音频 · 首次可获 5 美元免费额度"
          }
        }
      }
    },
