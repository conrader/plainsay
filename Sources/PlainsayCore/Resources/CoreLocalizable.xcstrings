    "audio.microphoneDenied": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonzugriff verweigert. Aktiviere ihn in Systemeinstellungen › Datenschutz & Sicherheit › Mikrofon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access denied. Enable it in System Settings › Privacy & Security › Microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso al micrófono denegado. Actívalo en Ajustes del sistema › Privacidad y seguridad › Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès au microphone refusé. Activez-le dans Réglages Système › Confidentialité et sécurité › Microphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso al microfono negato. Attivalo in Impostazioni di sistema › Privacy e sicurezza › Microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスが拒否されています。システム設定 › プライバシーとセキュリティ › マイクで有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근이 거부되었습니다. 시스템 설정 › 개인정보 보호 및 보안 › 마이크에서 허용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoontoegang geweigerd. Schakel dit in bij Systeeminstellingen › Privacy en beveiliging › Microfoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmówiono dostępu do mikrofonu. Włącz go w Ustawieniach systemowych › Prywatność i ochrona › Mikrofon."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso ao microfone negado. Ativa-o em Definições do sistema › Privacidade e Segurança › Microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону запрещён. Включите его в Системных настройках › Конфиденциальность и безопасность › Микрофон."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до мікрофона заборонено. Увімкніть його в Системних налаштуваннях › Конфіденційність і безпека › Мікрофон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风访问被拒绝。请在「系统设置 › 隐私与安全性 › 麦克风」中启用。"
          }
        }
      }
    },
    "audio.noInputDevice": {
