    "permission.reason.accessibility": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den transkribierten Text in die verwendete App einzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To paste the transcribed text into the app you're using."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pegar el texto transcrito en la app que estés usando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour coller le texte transcrit dans l'app que vous utilisez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per incollare il testo trascritto nell'app che stai usando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中のアプリに文字起こしされたテキストを貼り付けるため。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중인 앱에 필사된 텍스트를 붙여넣기 위해서입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om de getranscribeerde tekst in de app die je gebruikt te plakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "By wklejać transkrybowany tekst do używanej aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para colar o texto transcrito na app que estás a usar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вставки расшифрованного текста в используемое приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вставки розшифрованого тексту в застосунок, яким ви користуєтесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于将转录文字粘贴到你正在使用的应用中。"
          }
        }
      }
    },
    "permission.reason.inputMonitoring": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Tastenkombination zu bemerken, während eine andere App im Fokus ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To notice the hotkey while another app is focused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para detectar el atajo mientras otra app tiene el foco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour détecter le raccourci pendant qu'une autre app est au premier plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rilevare la scorciatoia mentre un'altra app è in primo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリが前面にあるときにホットキーを検知するため。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 활성화되어 있을 때 단축키를 감지하기 위해서입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om de sneltoets te herkennen terwijl een andere app actief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "By wykrywać skrót, gdy skupiona jest inna aplikacja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para detetar o atalho enquanto outra app está em primeiro plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы замечать нажатие клавиши, когда активно другое приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб помічати натискання клавіші, коли активний інший застосунок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在其他应用处于焦点状态时检测快捷键。"
          }
        }
      }
    },
    "permission.reason.microphone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deine Stimme aufzunehmen, während die Tastenkombination gehalten wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To record your voice while the hotkey is held."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para grabar tu voz mientras mantienes pulsado el atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer votre voix pendant que le raccourci est maintenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per registrare la tua voce mentre tieni premuta la scorciatoia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホットキーを押している間、声を録音するため。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 누르고 있는 동안 목소리를 녹음하기 위해서입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om je stem op te nemen terwijl de sneltoets is ingedrukt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "By nagrywać Twój głos, gdy skrót jest przytrzymany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gravar a tua voz enquanto mantens o atalho premido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для записи вашего голоса, пока удерживается клавиша."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для запису вашого голосу, поки утримується клавіша."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在按住快捷键时录制你的声音。"
          }
        }
      }
    },
