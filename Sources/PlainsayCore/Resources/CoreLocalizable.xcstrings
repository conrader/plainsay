    "voiceFilter.sampleTooShort": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufnahme war zu kurz, um daraus eine Stimme zu lernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That recording was too short to learn a voice from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa grabación fue demasiado corta para aprender una voz de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement était trop court pour en apprendre une voix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella registrazione era troppo breve per imparare una voce da essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音は短すぎて声を学習できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음은 너무 짧아서 목소리를 학습할 수 없었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die opname was te kort om een stem van te leren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nagranie było zbyt krótkie, by nauczyć się z niego głosu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa gravação foi demasiado curta para aprender uma voz a partir dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта запись слишком короткая, чтобы распознать по ней голос."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей запис занадто короткий, щоб розпізнати за ним голос."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段录音太短，无法据此识别声音。"
          }
        }
      }
    }
