    "audio.converterUnavailable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio kann nicht von %@Hz auf 16kHz Mono konvertiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot convert audio from %@Hz to 16kHz mono."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede convertir el audio de %@Hz a 16kHz mono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de convertir l'audio de %@Hz vers 16kHz mono."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile convertire l'audio da %@Hz a 16kHz mono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を %@Hz から16kHzモノラルに変換できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 %@Hz에서 16kHz 모노로 변환할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan audio niet converteren van %@Hz naar 16kHz mono."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przekonwertować audio z %@Hz na 16kHz mono."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível converter áudio de %@Hz para 16kHz mono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся преобразовать аудио из %@ Гц в 16 кГц моно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдається перетворити аудіо з %@ Гц на 16 кГц моно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将音频从 %@Hz 转换为 16kHz 单声道。"
          }
        }
      }
    },
