          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリでも口述筆記できます。設定はいつでもメニューバーから利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 앱에서든 받아쓰기를 할 수 있습니다. 설정은 언제든 메뉴 막대에서 이용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt in elke app dicteren. Instellingen zijn altijd beschikbaar via de menubalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz dyktować w dowolnej aplikacji. Ustawienia są zawsze dostępne z paska menu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes ditar em qualquer app. As definições estão sempre disponíveis a partir da barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете диктовать в любое приложение. Настройки всегда доступны из строки меню."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете диктувати в будь-який застосунок. Налаштування завжди доступні з рядка меню."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在任意应用中听写。设置随时可以从菜单栏打开。"
          }
        }
      }
    },
