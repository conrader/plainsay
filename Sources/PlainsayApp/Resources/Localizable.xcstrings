    "hud.a11y.savedToClipboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts war fokussiert zum Einfügen. Diktat in der Zwischenablage gespeichert — Befehl V drücken, um es einzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was focused to paste into. Dictation saved to the clipboard — press Command V to paste it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No había nada seleccionado donde pegar. Dictado guardado en el portapapeles — pulsa Comando V para pegarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'était sélectionné pour coller. Dictée enregistrée dans le presse-papiers — appuyez sur Commande V pour la coller."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun elemento selezionato per l'incollaggio. Dettato salvato negli appunti — premi Comando V per incollarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付け先が選択されていませんでした。口述筆記はクリップボードに保存されました——Command Vで貼り付けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여넣을 위치가 선택되어 있지 않았습니다. 받아쓰기가 클립보드에 저장되었습니다 — Command V를 눌러 붙여넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er was niets geselecteerd om in te plakken. Dictatie opgeslagen op het klembord — druk op Command V om te plakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie było aktywne, by wkleić tekst. Dyktowanie zapisano w schowku — naciśnij Command V, by je wkleić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada estava selecionado para colar. Ditado guardado na área de transferência — prime Comando V para o colar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не было куда вставить. Запись сохранена в буфер обмена — нажмите Command V, чтобы вставить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не було куди вставити. Запис збережено в буфер обміну — натисніть Command V, щоб вставити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可粘贴的焦点位置。听写内容已保存到剪贴板——按 Command V 即可粘贴。"
          }
        }
      }
    },
