    "A proven model family with several size and language options": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine bewährte Modellfamilie mit mehreren Größen- und Sprachoptionen"
          }
        },
        "en": {
          "stringUnit": {
