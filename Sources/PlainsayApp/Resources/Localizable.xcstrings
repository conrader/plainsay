    "Choose a speech model, shortcut, and review the permissions Plainsay needs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Sprachmodell und eine Tastenkombination, und prüfe die Berechtigungen, die Plainsay benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a speech model, shortcut, and review the permissions Plainsay needs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un modelo de voz, un atajo y revisa los permisos que necesita Plainsay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un modèle vocal, un raccourci, et vérifiez les autorisations dont Plainsay a besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un modello vocale, una scorciatoia e verifica i permessi di cui Plainsay ha bisogno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声モデルとショートカットを選び、Plainsayに必要な権限を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 모델과 단축키를 선택하고, Plainsay에 필요한 권한을 검토합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een spraakmodel, sneltoets, en bekijk de machtigingen die Plainsay nodig heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz model mowy, skrót klawiszowy i sprawdź uprawnienia, których potrzebuje Plainsay."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe um modelo de voz, um atalho e revê as permissões de que o Plainsay precisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите модель распознавания речи, сочетание клавиш и проверьте разрешения, которые нужны Plainsay."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть мовленнєву модель, комбінацію клавіш і перевірте дозволи, потрібні Plainsay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
