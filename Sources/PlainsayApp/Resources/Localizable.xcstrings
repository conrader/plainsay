    "wizard.permissions.detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Berechtigung hat eine eng begrenzte Aufgabe. Wähle Erlauben, wenn du bereit bist; du kannst fortfahren, auch wenn du das später abschließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each permission has one narrow job. Choose Grant when you are ready; you can continue even if you finish these later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada permiso tiene una única función concreta. Elige Conceder cuando estés listo; puedes continuar aunque termines esto más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque autorisation a un rôle bien précis. Choisissez Autoriser quand vous êtes prêt ; vous pouvez continuer même si vous terminez cela plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni permesso ha un compito specifico. Scegli Concedi quando sei pronto; puoi continuare anche se li completi più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それぞれの権限には限定的な役割が1つあります。準備ができたら「許可」を選んでください。後で完了させても続けることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 권한은 하나의 좁은 역할만 합니다. 준비되면 허용을 선택하세요. 나중에 마쳐도 계속 진행할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke machtiging heeft één specifieke taak. Kies Toestaan wanneer je zover bent; je kunt doorgaan, ook als je deze later afrondt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde uprawnienie ma jedno wąskie zadanie. Wybierz Przyznaj, gdy będziesz gotów; możesz kontynuować, nawet jeśli dokończysz to później."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada permissão tem uma única função específica. Escolhe Conceder quando estiveres pronto; podes continuar mesmo que termines isto mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого разрешения одна узкая задача. Нажимайте «Разрешить», когда будете готовы; можно продолжить, даже если закончите с этим позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У кожного дозволу одне вузьке завдання. Натискайте «Дозволити», коли будете готові; можна продовжити, навіть якщо завершите це пізніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每项权限只对应一项具体功能。准备好后点击「授权」；即使稍后再完成，也可以先继续。"
          }
        }
      }
    },
