    "settings.vocabulary.explanation.other": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Namen, Fachbegriffe und Produktnamen hinzu, die verstümmelt herauskommen. Plainsay gibt sie an das Sprachmodell weiter und korrigiert danach verbleibende Schreibfehler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add names, jargon, and product names that come out garbled. Plainsay feeds them to the speech model, then corrects any spellings it still gets wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade nombres, jerga y nombres de producto que salen distorsionados. Plainsay los pasa al modelo de voz y luego corrige cualquier grafía que siga fallando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les noms, le jargon et les noms de produits qui ressortent déformés. Plainsay les transmet au modèle vocal, puis corrige les fautes d'orthographe restantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi nomi, gergo e nomi di prodotto che risultano storpiati. Plainsay li passa al modello vocale, poi corregge eventuali grafie ancora sbagliate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字化けして出てくる名前、専門用語、製品名を追加してください。Plainsayはそれらを音声モデルに渡し、その後も残っているスペルの誤りを修正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜곡되어 나오는 이름, 전문 용어, 제품명을 추가하세요. Plainsay가 이를 음성 모델에 전달한 다음, 여전히 남아 있는 철자 오류를 수정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg namen, jargon en productnamen toe die vervormd overkomen. Plainsay geeft ze door aan het spraakmodel en corrigeert daarna eventuele resterende spelfouten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj nazwy, żargon i nazwy produktów, które wychodzą zniekształcone. Plainsay przekazuje je modelowi mowy, a potem poprawia zapisy, które wciąż wychodzą błędnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona nomes, jargão e nomes de produtos que saem distorcidos. O Plainsay envia-os ao modelo de voz e depois corrige qualquer grafia que ainda esteja errada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте имена, термины и названия продуктов, которые распознаются с искажениями. Plainsay передаёт их речевой модели, а затем исправляет написания, которые всё равно распознаются неверно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавайте імена, терміни та назви продуктів, які розпізнаються з викривленнями. Plainsay передає їх мовленнєвій моделі, а потім виправляє написання, які все одно розпізнаються неправильно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加容易被识别错的姓名、专业术语和产品名称。Plainsay 会将它们提供给语音模型，然后再纠正仍然出错的拼写。"
          }
        }
      }
    },
    "settings.vocabulary.explanation.parakeet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Namen, Fachbegriffe und Produktnamen hinzu, die verstümmelt herauskommen. Parakeet akzeptiert keine Decoder-Hinweise, daher korrigiert Plainsay diese Schreibweisen selbst direkt nach der Transkription, unabhängig davon, ob die Bearbeitung aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add names, jargon, and product names that come out garbled. Parakeet does not accept decoder hints, so Plainsay corrects these spellings itself right after transcribing, whether or not editing is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade nombres, jerga y nombres de producto que salen distorsionados. Parakeet no acepta pistas para el decodificador, así que Plainsay corrige estas grafías por su cuenta justo después de transcribir, tanto si la edición está activada como si no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les noms, le jargon et les noms de produits qui ressortent déformés. Parakeet n'accepte pas d'indices pour le décodeur, donc Plainsay corrige lui-même ces orthographes juste après la transcription, que l'édition soit activée ou non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi nomi, gergo e nomi di prodotto che risultano storpiati. Parakeet non accetta suggerimenti per il decoder, quindi Plainsay corregge da sé queste grafie subito dopo la trascrizione, sia che l'editing sia attivo sia che non lo sia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字化けして出てくる名前、専門用語、製品名を追加してください。Parakeetはデコーダーヒントを受け付けないため、Plainsayは編集のオン・オフに関わらず、文字起こし直後にこれらのスペルを自分で修正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜곡되어 나오는 이름, 전문 용어, 제품명을 추가하세요. Parakeet는 디코더 힌트를 받아들이지 않으므로, 편집 여부와 관계없이 Plainsay가 필사 직후 이러한 철자를 직접 수정합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg namen, jargon en productnamen toe die vervormd overkomen. Parakeet accepteert geen decoderhints, dus Plainsay corrigeert deze spellingen zelf direct na het transcriberen, ongeacht of bewerken aanstaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj nazwy, żargon i nazwy produktów, które wychodzą zniekształcone. Parakeet nie przyjmuje podpowiedzi dekodera, więc Plainsay poprawia te zapisy sama, zaraz po transkrypcji, niezależnie od tego, czy edycja jest włączona."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona nomes, jargão e nomes de produtos que saem distorcidos. O Parakeet não aceita pistas para o descodificador, por isso o Plainsay corrige estas grafias por conta própria logo após a transcrição, quer a edição esteja ativa quer não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте имена, термины и названия продуктов, которые распознаются с искажениями. Parakeet не принимает подсказки декодера, поэтому Plainsay сам исправляет эти написания сразу после расшифровки — независимо от того, включено редактирование или нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавайте імена, терміни та назви продуктів, які розпізнаються з викривленнями. Parakeet не приймає підказки декодера, тож Plainsay сам виправляє ці написання одразу після розшифровки — незалежно від того, увімкнене редагування чи ні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加容易被识别错的姓名、专业术语和产品名称。Parakeet 不接受解码器提示，因此 Plainsay 会在转录完成后立即自行纠正这些拼写——无论是否启用了编辑功能。"
          }
        }
      }
    },
