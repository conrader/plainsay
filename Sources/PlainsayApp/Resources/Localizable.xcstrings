          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd %@ ingedrukt tijdens het spreken. Laat los om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj %@ podczas mówienia. Puść, by zatrzymać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém premido %@ enquanto falas. Solta-o para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %@ во время речи. Отпустите, чтобы остановить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте %@ під час мовлення. Відпустіть, щоб зупинити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话时按住 %@。松开即可停止。"
          }
        }
      }
    },
    "wizard.shortcut.hint.holdOrTap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ beim Sprechen halten, oder einmal tippen, um die Aufnahme fortzusetzen, und erneut tippen, um zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ while speaking, or tap once to keep recording and tap again to stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado %@ mientras hablas, o pulsa una vez para seguir grabando y vuelve a pulsar para detener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ en parlant, ou appuyez une fois pour continuer l'enregistrement et appuyez à nouveau pour arrêter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %@ mentre parli, oppure premi una volta per continuare a registrare e premi di nuovo per fermarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を押しながら話す、または一度タップして録音を続け、もう一度タップして停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 를 누른 채로 말하거나, 한 번 탭해서 계속 녹음하고 다시 탭해서 멈추세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd %@ ingedrukt tijdens het spreken, of tik eenmaal om te blijven opnemen en tik nogmaals om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj %@ podczas mówienia, albo stuknij raz, by kontynuować nagrywanie, i stuknij ponownie, by zatrzymać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém premido %@ enquanto falas, ou prime uma vez para continuar a gravar e prime de novo para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %@ во время речи, либо нажмите один раз, чтобы продолжить запись, и ещё раз, чтобы остановить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте %@ під час мовлення, або натисніть один раз, щоб продовжити запис, і ще раз, щоб зупинити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话时按住 %@，或轻按一次以持续录音，再次轻按即可停止。"
          }
        }
      }
    },
    "wizard.shortcut.hint.tap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tippen, um zu starten, erneut tippen, um zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap %@ to start, then tap it again to stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ para empezar, y vuelve a pulsarlo para detener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %@ pour démarrer, puis appuyez à nouveau pour arrêter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi %@ per iniziare, poi premilo di nuovo per fermarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をタップして開始し、もう一度タップして停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 를 탭해서 시작하고, 다시 탭해서 멈추세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op %@ om te starten, tik er nogmaals op om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij %@, by zacząć, stuknij ponownie, by zatrzymać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prime %@ para começar, depois prime de novo para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@, чтобы начать, и ещё раз, чтобы остановить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть %@, щоб почати, і ще раз, щоб зупинити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻按 %@ 开始，再次轻按即可停止。"
          }
        }
      }
    },
