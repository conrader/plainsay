    "voice.recordingCountdown": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme läuft — sprich noch %d s weiter…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording — keep talking for %ds…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabando — sigue hablando %ds…"
          }
        },
        "fr": {
