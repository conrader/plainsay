    "wizard.voice.detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du oft dort diktierst, wo andere Leute sprechen, kann Plainsay deine Stimme lernen und alle anderen vor der Transkription herausfiltern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you often dictate somewhere with other people talking, Plainsay can learn your voice and filter everyone else out before transcription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sueles dictar en un sitio con otras personas hablando, Plainsay puede aprender tu voz y filtrar a todos los demás antes de la transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous dictez souvent dans un endroit où d'autres personnes parlent, Plainsay peut apprendre votre voix et filtrer tout le reste avant la transcription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se spesso detti in un posto con altre persone che parlano, Plainsay può imparare la tua voce e filtrare tutti gli altri prima della trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人が話している場所でよく口述筆記をするなら、Plainsayにあなたの声を学習させて、文字起こしの前に他の声をすべて除外できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람들이 이야기하는 곳에서 자주 받아쓰기를 한다면, Plainsay가 당신의 목소리를 학습하여 필사 전에 나머지 목소리를 모두 걸러낼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je vaak dicteert op plekken waar andere mensen praten, kan Plainsay je stem leren herkennen en iedereen anders eruit filteren vóór transcriptie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli często dyktujesz tam, gdzie mówią inne osoby, Plainsay może nauczyć się Twojego głosu i odfiltrować resztę przed transkrypcją."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se costumas ditar num sítio com outras pessoas a falar, o Plainsay pode aprender a tua voz e filtrar todas as outras antes da transcrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы часто диктуете там, где рядом разговаривают другие люди, Plainsay может научиться распознавать ваш голос и отфильтровывать остальные перед расшифровкой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви часто диктуєте там, де поруч розмовляють інші люди, Plainsay може навчитися розпізнавати ваш голос і відфільтровувати решту перед розшифровкою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你经常在有其他人说话的环境中听写，Plainsay 可以学习你的声音，并在转录前过滤掉其他所有人的声音。"
          }
        }
      }
    },
    "wizard.voice.title": {
      "localizations": {
