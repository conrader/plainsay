    "wizard.shortcut.detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze eine Taste aus jeder App. Plainsay lauscht nur, während das Diktat aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use one key from any app. Plainsay listens only while dictation is active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una sola tecla desde cualquier app. Plainsay solo escucha mientras el dictado está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une touche depuis n'importe quelle app. Plainsay n'écoute que pendant que la dictée est active."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un solo tasto da qualsiasi app. Plainsay ascolta solo mentre il dettato è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでも1つのキーで使えます。Plainsayは口述筆記が有効な間だけ聞き取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 앱에서든 키 하나로 사용하세요. Plainsay는 받아쓰기가 활성화된 동안에만 듣습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik één toets vanuit elke app. Plainsay luistert alleen zolang dicteren actief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj jednego klawisza z dowolnej aplikacji. Plainsay nasłuchuje tylko, gdy dyktowanie jest aktywne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa uma única tecla a partir de qualquer app. O Plainsay só escuta enquanto o ditado está ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте одну клавишу в любом приложении. Plainsay слушает, только пока диктовка активна."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте одну клавішу в будь-якому застосунку. Plainsay слухає, лише поки диктування активне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任意应用中使用同一个按键。Plainsay 只在听写激活时才会监听。"
          }
        }
      }
    },
    "wizard.shortcut.hint.hold": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ beim Sprechen halten. Loslassen, um zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
