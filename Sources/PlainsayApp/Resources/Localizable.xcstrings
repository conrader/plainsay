    "wizard.speech.detail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte ohne Modell-Download mit Plainsay Cloud, oder behalte Spracherkennung und aufgenommenes Audio auf diesem Mac. Der nächste Schritt konfiguriert die gewählte Option."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start without a model download with Plainsay Cloud, or keep speech recognition and recorded audio on this Mac. The next step configures whichever you pick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza sin descargar ningún modelo con Plainsay Cloud, o mantén el reconocimiento de voz y el audio grabado en este Mac. El siguiente paso configura el que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez sans téléchargement de modèle avec Plainsay Cloud, ou gardez la reconnaissance vocale et l'audio enregistré sur ce Mac. L'étape suivante configure votre choix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia senza scaricare alcun modello con Plainsay Cloud, oppure mantieni il riconoscimento vocale e l'audio registrato su questo Mac. Il prossimo passaggio configura quello che scegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plainsay Cloudならモデルのダウンロードなしで始められます。あるいは音声認識と録音をこのMac上に留めることもできます。次のステップで選んだ方を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plainsay Cloud로 모델 다운로드 없이 시작하거나, 음성 인식과 녹음을 이 Mac에 유지할 수 있습니다. 다음 단계에서 선택한 방식을 구성합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin zonder modeldownload met Plainsay Cloud, of houd spraakherkenning en opgenomen audio op deze Mac. De volgende stap configureert wat je ook kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij bez pobierania modelu dzięki Plainsay Cloud, albo zachowaj rozpoznawanie mowy i nagrane audio na tym Macu. Następny krok konfiguruje wybraną opcję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa sem transferir qualquer modelo com o Plainsay Cloud, ou mantém o reconhecimento de voz e o áudio gravado neste Mac. O passo seguinte configura a opção que escolheres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните без загрузки модели с Plainsay Cloud, либо оставьте распознавание речи и записанное аудио на этом Mac. Следующий шаг настроит выбранный вариант."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть без завантаження моделі з Plainsay Cloud, або залиште розпізнавання мовлення й записане аудіо на цьому Mac. Наступний крок налаштує обраний варіант."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Plainsay Cloud，无需下载模型即可开始；或者将语音识别和录制的音频保留在这台 Mac 上。下一步会根据你的选择进行配置。"
          }
        }
      }
    },
