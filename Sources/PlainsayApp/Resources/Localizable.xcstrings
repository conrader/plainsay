          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중 — %d초 더 말해 주세요…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezig met opnemen — blijf nog %ds praten…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie — mów jeszcze przez %ds…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravar — continua a falar durante %ds…"
          }
        },
        "ru": {
