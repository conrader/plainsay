    "wizard.ready.detail.finishInBackground": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Einrichtung jetzt abschließen. Die Vorbereitung läuft im Hintergrund weiter, und die Menüleiste zeigt an, wann diktiert werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can finish setup now. Preparation continues in the background, and the menu bar shows when dictation is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya puedes terminar la configuración. La preparación continúa en segundo plano, y la barra de menús muestra cuándo el dictado está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez terminer la configuration maintenant. La préparation continue en arrière-plan, et la barre de menus indique quand la dictée est disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi terminare la configurazione ora. La preparazione continua in background e la barra dei menu mostra quando il dettato è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐセットアップを終了できます。準備はバックグラウンドで続き、口述筆記が使えるようになるとメニューバーに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 설정을 마칠 수 있습니다. 준비는 백그라운드에서 계속되며, 받아쓰기를 사용할 수 있게 되면 메뉴 막대에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de installatie nu afronden. De voorbereiding gaat door op de achtergrond, en de menubalk toont wanneer dicteren beschikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz dokończyć konfigurację teraz. Przygotowanie trwa w tle, a pasek menu pokaże, gdy dyktowanie będzie dostępne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já podes terminar a configuração. A preparação continua em segundo plano, e a barra de menus mostra quando o ditado está disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете завершить настройку сейчас. Подготовка продолжится в фоне, а строка меню покажет, когда диктовка станет доступна."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете завершити налаштування зараз. Підготовка триватиме у фоні, а рядок меню покаже, коли диктування стане доступним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在就可以完成设置。准备工作将在后台继续，菜单栏会在听写可用时提示你。"
          }
        }
      }
    },
    "wizard.ready.detail.needsAttention": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe den unten stehenden Punkt ab, bevor das Diktieren starten kann. Deine Einrichtungswahl wurde gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the item below before dictation can start. Your setup choice has been saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina lo siguiente antes de que el dictado pueda empezar. Tu elección de configuración ya se ha guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez l'élément ci-dessous avant que la dictée puisse démarrer. Votre choix de configuration a été enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa quanto segue prima che il dettato possa iniziare. La tua scelta di configurazione è già stata salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口述筆記を始める前に、下の項目を完了してください。設定した選択は保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기를 시작하려면 아래 항목을 완료하세요. 설정한 선택 사항은 저장되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond het onderstaande punt af voordat dicteren kan starten. Jouw installatiekeuze is opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokończ poniższy punkt, zanim dyktowanie zacznie działać. Twój wybór konfiguracji został zapisany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina o item abaixo antes de o ditado poder começar. A tua escolha de configuração já foi guardada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите пункт ниже, прежде чем диктовка сможет заработать. Ваш выбор настроек сохранён."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть пункт нижче, перш ніж диктування зможе запрацювати. Ваш вибір налаштувань збережено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成下方的事项，听写才能开始使用。你的设置选择已保存。"
          }
        }
      }
    },
    "wizard.ready.detail.ready": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst in jede App diktieren. Einstellungen sind jederzeit über die Menüleiste verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can dictate into any app. Settings are always available from the menu bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes dictar en cualquier app. Los ajustes siempre están disponibles desde la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
