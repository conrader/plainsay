          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell Plainsay which languages you actually speak, and how it should tidy up the words before inserting them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica a Plainsay qué idiomas hablas realmente y cómo debe pulir las palabras antes de insertarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez à Plainsay les langues que vous parlez réellement, et comment il doit nettoyer les mots avant de les insérer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica a Plainsay le lingue che parli davvero, e come deve rifinire le parole prima di inserirle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際に話す言語と、挿入する前に単語をどう整えるかをPlainsayに伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제로 사용하는 언어와, 삽입하기 전에 단어를 어떻게 다듬을지 Plainsay에게 알려주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertel Plainsay welke talen je daadwerkelijk spreekt, en hoe het de woorden moet opschonen voordat ze worden ingevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz Plainsay, którymi językami faktycznie mówisz i jak ma porządkować słowa przed ich wstawieniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica ao Plainsay que idiomas realmente falas e como deve aperfeiçoar as palavras antes de as inserir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите Plainsay, на каких языках вы говорите, и как приводить слова в порядок перед вставкой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розкажіть Plainsay, якими мовами ви говорите, і як приводити слова до ладу перед вставкою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉 Plainsay 你实际使用的语言，以及在插入文字前该如何整理措辞。"
          }
        }
      }
    },
