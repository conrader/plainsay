    "settings.behaviorHint.hold": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ halten und sprechen. Die Aufnahme endet beim Loslassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ and speak. Recording ends when you let go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado %@ y habla. La grabación termina al soltarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ et parlez. L'enregistrement s'arrête quand vous relâchez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %@ e parla. La registrazione termina quando lo rilasci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を押しながら話します。離すと録音が終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 를 누른 채로 말하세요. 손을 떼면 녹음이 종료됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd %@ ingedrukt en spreek. Opnemen stopt zodra je loslaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj %@ i mów. Nagrywanie kończy się po puszczeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém premido %@ e fala. A gravação termina quando o soltas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %@ и говорите. Запись заканчивается, когда вы отпускаете клавишу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте %@ і говоріть. Запис завершується, коли ви відпускаєте клавішу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %@ 说话。松开即结束录音。"
          }
        }
      }
    },
    "settings.behaviorHint.holdOrTap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ halten und sprechen, oder einmal tippen, um die Aufnahme fortzusetzen, und erneut tippen, um zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ and speak, or tap it once to keep recording and tap again to stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado %@ y habla, o pulsa una vez para seguir grabando y vuelve a pulsar para detener."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %@ et parlez, ou appuyez une fois pour continuer l'enregistrement et appuyez à nouveau pour arrêter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %@ e parla, oppure premi una volta per continuare a registrare e premi di nuovo per fermarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を押しながら話す、または一度タップして録音を続け、もう一度タップして停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 를 누른 채로 말하거나, 한 번 탭해서 계속 녹음하고 다시 탭해서 멈추세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd %@ ingedrukt en spreek, of tik er eenmaal op om te blijven opnemen en tik nogmaals om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj %@ i mów, albo stuknij raz, by kontynuować nagrywanie, i stuknij ponownie, by zatrzymać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém premido %@ e fala, ou prime uma vez para continuar a gravar e prime de novo para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %@ и говорите, либо нажмите один раз, чтобы продолжить запись, и ещё раз, чтобы остановить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте %@ і говоріть, або натисніть один раз, щоб продовжити запис, і ще раз, щоб зупинити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %@ 说话，或轻按一次以持续录音，再次轻按即可停止。"
          }
        }
      }
    },
    "settings.behaviorHint.tap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tippen, um die Aufnahme zu starten, erneut tippen, um zu stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap %@ to start recording, tap again to stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
