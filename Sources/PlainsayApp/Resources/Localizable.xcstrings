          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi %@ per iniziare a registrare, premi di nuovo per fermarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をタップして録音を開始し、もう一度タップして停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 를 탭해서 녹음을 시작하고, 다시 탭해서 멈추세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op %@ om op te nemen, tik nogmaals om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij %@, by rozpocząć nagrywanie, stuknij ponownie, by zatrzymać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prime %@ para começar a gravar, prime de novo para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@, чтобы начать запись, и ещё раз, чтобы остановить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть %@, щоб почати запис, і ще раз, щоб зупинити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻按 %@ 开始录音，再次轻按即可停止。"
          }
        }
      }
    },
    "settings.editingStatus.configured": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bearbeitung läuft über %@ mit %@. Ein Fehler führt immer zum unbearbeiteten Text zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing runs through %@ using %@. A failure always falls back to the raw transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edición se ejecuta a través de %@ usando %@. Un fallo siempre vuelve al transcrito sin editar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'édition fonctionne via %@ avec %@. Un échec revient toujours à la transcription brute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'editing viene eseguito tramite %@ usando %@. Un errore torna sempre alla trascrizione non elaborata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集は %@ を通じて %@ を使って実行されます。失敗した場合は常に生の文字起こしにフォールバックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집은 %@ 를 통해 %@ 를 사용해 실행됩니다. 실패하면 항상 원본 필사본으로 대체됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerken verloopt via %@ met %@. Bij een fout wordt altijd teruggevallen op het ruwe transcript."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edycja działa poprzez %@, używając %@. Błąd zawsze skutkuje powrotem do surowego transkryptu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A edição é executada através de %@ usando %@. Uma falha volta sempre à transcrição em bruto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактирование работает через %@, используя %@. При сбое всегда используется необработанная расшифровка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагування працює через %@, використовуючи %@. У разі збою завжди застосовується необроблена розшифровка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑功能通过 %@ 运行，使用 %@ 模型。一旦失败，将始终回退到原始转录文本。"
          }
        }
      }
    },
    "settings.editingStatus.notConfigured": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht konfiguriert — Plainsay fügt den unbearbeiteten Text ein, bis ein Schlüssel gespeichert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not configured — Plainsay will insert the raw transcript until a key is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No configurado — Plainsay insertará el transcrito sin editar hasta que se guarde una clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non configuré — Plainsay insérera la transcription brute jusqu'à ce qu'une clé soit enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non configurato — Plainsay inserirà la trascrizione non elaborata finché non salvi una chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定です — キーが保存されるまでPlainsayは生の文字起こしを挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정되지 않음 — 키가 저장되기 전까지 Plainsay는 원본 필사본을 삽입합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet geconfigureerd — Plainsay voegt het ruwe transcript in totdat er een sleutel is opgeslagen."
