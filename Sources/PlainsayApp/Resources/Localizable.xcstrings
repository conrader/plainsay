    "wizard.plan.local.caveat2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegt Arbeitsspeicher, solange Plainsay läuft, nicht nur während des Diktierens"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps using memory the whole time Plainsay is running, not just while dictating"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue usando memoria todo el tiempo que Plainsay está en ejecución, no solo mientras dictas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise de la mémoire tant que Plainsay fonctionne, pas seulement pendant la dictée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a usare memoria per tutto il tempo in cui Plainsay è in esecuzione, non solo mentre detti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口述筆記中だけでなく、Plainsayの実行中はずっとメモリを使用し続けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기 중일 때뿐 아니라 Plainsay가 실행되는 내내 메모리를 계속 사용함"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijft geheugen gebruiken zolang Plainsay draait, niet alleen tijdens het dicteren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajmuje pamięć przez cały czas działania Plainsay, nie tylko podczas dyktowania"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a usar memória enquanto o Plainsay estiver em execução, não só enquanto ditas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занимает память всё время, пока Plainsay запущен, а не только во время диктовки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Займає пам'ять весь час, поки Plainsay запущено, а не лише під час диктування"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要 Plainsay 在运行就会持续占用内存，不仅限于听写期间"
          }
        }
      }
    },
