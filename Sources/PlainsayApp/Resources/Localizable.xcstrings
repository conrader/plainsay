    "settings.sourceExplanation.cloud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa 3 $/Monat: Transkription und Bearbeitung sind inklusive, ohne Modell-Download oder Schlüsselverwaltung. Audio wird an Plainsay Cloud hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About $3/month: transcription and cleanup are included, with no model download or keys to manage. Audio is uploaded to Plainsay Cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos 3 $/mes: la transcripción y la edición están incluidas, sin descarga de modelo ni claves que gestionar. El audio se sube a Plainsay Cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ 3 $/mois : transcription et nettoyage inclus, sans téléchargement de modèle ni clés à gérer. L'audio est envoyé à Plainsay Cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa 3 $/mese: trascrizione e pulizia sono incluse, senza download di modelli né chiavi da gestire. L'audio viene caricato su Plainsay Cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月額約3ドル: 文字起こしとクリーンアップが含まれ、モデルのダウンロードや管理するキーは不要です。音声はPlainsay Cloudにアップロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 약 3달러: 필사와 정리가 포함되며, 모델 다운로드나 관리할 키가 필요 없습니다. 오디오는 Plainsay Cloud로 업로드됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeveer $3/maand: transcriptie en opschonen zijn inbegrepen, zonder modeldownload of sleutels om te beheren. Audio wordt geüpload naar Plainsay Cloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Około 3 USD/miesiąc: transkrypcja i edycja są wliczone, bez pobierania modelu ani zarządzania kluczami. Audio jest przesyłane do Plainsay Cloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de 3 $/mês: a transcrição e a edição estão incluídas, sem transferência de modelo nem chaves para gerir. O áudio é enviado para o Plainsay Cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Около 3 $/месяц: расшифровка и редактирование включены, без загрузки модели и ключей для настройки. Аудио загружается в Plainsay Cloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизно 3 $/місяць: розшифровка і редагування включені, без завантаження моделі чи ключів для налаштування. Аудіо завантажується в Plainsay Cloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 3 美元/月：包含转录与清理功能，无需下载模型或管理密钥。音频会上传到 Plainsay Cloud。"
          }
        }
      }
    },
    "settings.sourceExplanation.local": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgenommenes Audio bleibt auf diesem Mac. Lokale Sprache benötigt einen Modell-Download und nutzt Speicher und Arbeitsspeicher des Mac; optionale Bearbeitung kann Transkripttext trotzdem an den konfigurierten Anbieter senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded audio stays on this Mac. Local speech needs a model download and uses Mac storage and memory; optional cleanup may still send transcript text to its configured provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio grabado se queda en este Mac. La voz local necesita descargar un modelo y usa almacenamiento y memoria del Mac; la edición opcional puede seguir enviando texto del transcrito a su proveedor configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio enregistré reste sur ce Mac. La voix locale nécessite un téléchargement de modèle et utilise le stockage et la mémoire du Mac ; le nettoyage optionnel peut quand même envoyer le texte de la transcription à son fournisseur configuré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio registrato resta su questo Mac. La voce locale richiede il download di un modello e usa spazio di archiviazione e memoria del Mac; la pulizia opzionale può comunque inviare il testo trascritto al provider configurato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音した音声はこのMac上に残ります。ローカル音声にはモデルのダウンロードが必要で、Macのストレージとメモリを使用します。任意のクリーンアップを有効にすると、文字起こしテキストが設定したプロバイダーに送信される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음된 오디오는 이 Mac에 남습니다. 로컬 음성은 모델 다운로드가 필요하며 Mac의 저장 공간과 메모리를 사용합니다. 선택적 정리 기능이 켜져 있으면 필사 텍스트가 설정된 제공사로 전송될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgenomen audio blijft op deze Mac. Lokale spraak vereist een modeldownload en gebruikt opslag en geheugen van de Mac; optioneel opschonen kan nog steeds transcripttekst naar de ingestelde provider sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrane audio pozostaje na tym Macu. Mowa lokalna wymaga pobrania modelu i zajmuje miejsce oraz pamięć Maca; opcjonalna edycja może wciąż wysyłać tekst transkryptu do skonfigurowanego dostawcy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio gravado fica neste Mac. A voz local precisa de transferir um modelo e usa armazenamento e memória do Mac; a edição opcional pode continuar a enviar texto da transcrição para o fornecedor configurado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записанное аудио остаётся на этом Mac. Локальная речь требует загрузки модели и использует память и хранилище Mac; при включённом редактировании текст расшифровки всё же может отправляться настроенному провайдеру."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записане аудіо залишається на цьому Mac. Локальне мовлення потребує завантаження моделі та використовує пам'ять і сховище Mac; за увімкненого редагування текст розшифровки все одно може надсилатися налаштованому постачальнику."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制的音频保留在这台 Mac 上。本地语音识别需要下载模型，并占用 Mac 的存储和内存；若启用了清理功能，转录文本仍可能被发送给所配置的供应商。"
          }
        }
      }
    },
    "settings.sourceExplanation.remote": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wird an einen Dienst hochgeladen, für den du den Schlüssel besitzt. Kein Modell-Download, Abrechnung pro Minute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is uploaded to a service you hold the key for. No model download, billed per minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se sube a un servicio del que tienes la clave. Sin descarga de modelo, se factura por minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio est envoyé à un service dont vous détenez la clé. Aucun téléchargement de modèle, facturé à la minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio viene caricato su un servizio di cui possiedi la chiave. Nessun download di modello, fatturazione al minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は、あなたがキーを持つサービスにアップロードされます。モデルのダウンロードは不要で、分単位で課金されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오는 당신이 키를 가진 서비스로 업로드됩니다. 모델 다운로드가 필요 없고, 분 단위로 청구됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio wordt geüpload naar een dienst waarvoor jij de sleutel hebt. Geen modeldownload, gefactureerd per minuut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio jest przesyłane do usługi, dla której masz klucz. Bez pobierania modelu, rozliczane za minutę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio é enviado para um serviço de que tens a chave. Sem transferência de modelo, faturado por minuto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио загружается в сервис, для которого у вас есть ключ. Без загрузки модели, оплата по минутам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо завантажується в сервіс, для якого у вас є ключ. Без завантаження моделі, оплата за хвилинами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频会上传到你持有密钥的服务。无需下载模型，按分钟计费。"
          }
        }
      }
    },
    "settings.updates.lastChecked": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt geprüft: %@. Plainsay wird außerhalb des App Store vertrieben und muss deshalb selbst nach Updates suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last checked: %@. Plainsay is distributed outside the App Store, so it has to check for its own updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última comprobación: %@. Plainsay se distribuye fuera de la App Store, así que tiene que buscar sus propias actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière vérification : %@. Plainsay est distribué hors du App Store, il doit donc vérifier lui-même les mises à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimo controllo: %@. Plainsay è distribuito fuori dall'App Store, quindi deve controllare da sé i propri aggiornamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終確認: %@。Plainsayはアプリストア外で配布されているため、自分でアップデートを確認する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 확인: %@. Plainsay는 앱스토어 외부에서 배포되므로 스스로 업데이트를 확인해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatst gecontroleerd: %@. Plainsay wordt buiten de App Store verspreid, dus het moet zelf op updates controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio sprawdzono: %@. Plainsay jest dystrybuowana poza App Store, więc sama musi sprawdzać aktualizacje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Última verificação: %@. O Plainsay é distribuído fora da App Store, por isso tem de procurar as suas próprias atualizações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя проверка: %@. Plainsay распространяется вне App Store, поэтому проверяет обновления самостоятельно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остання перевірка: %@. Plainsay поширюється поза App Store, тож перевіряє оновлення самостійно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次检查时间：%@。Plainsay 在 App Store 之外分发，因此需要自行检查更新。"
          }
        }
      }
    },
