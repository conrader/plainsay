        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieskonfigurowane — Plainsay będzie wstawiać surowy transkrypt, dopóki klucz nie zostanie zapisany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não configurado — o Plainsay vai inserir a transcrição em bruto até guardares uma chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не настроено — Plainsay будет вставлять необработанную расшифровку, пока не сохранён ключ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не налаштовано — Plainsay вставлятиме необроблену розшифровку, поки не збережено ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配置——在保存密钥之前，Plainsay 会插入未经处理的原始转录文本。"
          }
        }
      }
    },
