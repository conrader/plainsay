    "No key yet — Plainsay will insert the raw transcript until one is saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Schlüssel — Plainsay fügt den unbearbeiteten Text ein, bis einer gespeichert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No key yet — Plainsay will insert the raw transcript until one is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay clave — Plainsay insertará el transcrito sin editar hasta que se guarde una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de clé — Plainsay insérera la transcription brute jusqu'à ce qu'une clé soit enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna chiave — Plainsay inserirà la trascrizione non elaborata finché non ne salvi una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだキーがありません——保存されるまでPlainsayは生の文字起こしを挿入します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 키가 없습니다 — 저장되기 전까지 Plainsay는 원본 필사본을 삽입합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen sleutel — Plainsay voegt het ruwe transcript in totdat er een is opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak klucza — Plainsay będzie wstawiać surowy transkrypt, dopóki klucz nie zostanie zapisany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há chave — o Plainsay vai inserir a transcrição em bruto até guardares uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключа пока нет — Plainsay будет вставлять необработанную расшифровку, пока ключ не сохранён."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключа поки немає — Plainsay вставлятиме необроблену розшифровку, поки ключ не збережено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置密钥——在保存密钥之前，Plainsay 会插入未经处理的原始转录文本。"
          }
        }
      }
    },
