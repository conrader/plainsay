    "voice.tooQuiet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das war zu leise oder zu kurz — versuch es erneut und sprich deutlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That was too quiet or too short — try again and speak clearly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonó demasiado bajo o fue demasiado corto — inténtalo de nuevo y habla con claridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'était trop faible ou trop court — réessayez et parlez clairement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il volume era troppo basso o la registrazione troppo breve — riprova e parla chiaramente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音が小さすぎるか短すぎました——もう一度、はっきりと話してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 조용하거나 짧았습니다 — 다시 시도하고 또렷하게 말해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat was te zacht of te kort — probeer het opnieuw en spreek duidelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Było za cicho lub za krótko — spróbuj ponownie i mów wyraźnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficou demasiado baixo ou demasiado curto — tenta de novo e fala com clareza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком тихо или слишком коротко — попробуйте ещё раз и говорите отчётливо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занадто тихо або занадто коротко — спробуйте ще раз і говоріть чітко."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音太小或时间太短——请再试一次，并清晰地说话。"
          }
        }
      }
    },
