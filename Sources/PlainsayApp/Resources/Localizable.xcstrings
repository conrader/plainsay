    "wizard.configure.detail.byok": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio verlässt diesen Mac, und es können Kosten des Anbieters anfallen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio leaves this Mac and provider charges may apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio sale de este Mac y pueden aplicarse cargos del proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio quitte ce Mac et des frais de fournisseur peuvent s'appliquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio lascia questo Mac e potrebbero essere applicati costi del provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はこのMacの外に送信され、プロバイダーの料金が発生する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 이 Mac을 벗어나며 제공사 요금이 발생할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio verlaat deze Mac en providerkosten kunnen van toepassing zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio opuszcza tego Maca i mogą obowiązywać opłaty dostawcy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio sai deste Mac e podem aplicar-se custos do fornecedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио покидает этот Mac, возможна плата от провайдера."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо залишає цей Mac, можлива плата від постачальника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频会离开这台 Mac，可能产生供应商费用。"
          }
        }
      }
    },
    "wizard.configure.detail.cloud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal anmelden. Plainsay Cloud liefert Spracherkennung und Bearbeitung, ohne großes Modell, das auf diesem Mac vorbereitet werden müsste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in once. Plainsay Cloud supplies speech transcription and cleanup, with no large model to prepare on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión una vez. Plainsay Cloud aporta la transcripción de voz y la edición, sin necesidad de preparar un modelo grande en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous une fois. Plainsay Cloud fournit la transcription vocale et l'édition, sans gros modèle à préparer sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi una volta sola. Plainsay Cloud fornisce trascrizione vocale ed editing, senza dover preparare un modello grande su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度サインインすれば完了です。Plainsay Cloudが音声の文字起こしとクリーンアップを提供するので、このMac上で大きなモデルを準備する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 로그인하세요. Plainsay Cloud가 음성 필사와 정리를 제공하므로 이 Mac에서 큰 모델을 준비할 필요가 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log eenmalig in. Plainsay Cloud levert spraaktranscriptie en opschonen, zonder groot model om op deze Mac voor te bereiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się raz. Plainsay Cloud zapewnia transkrypcję mowy i edycję, bez dużego modelu do przygotowania na tym Macu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessão uma vez. O Plainsay Cloud fornece a transcrição de voz e a edição, sem ser preciso preparar um modelo grande neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите один раз. Plainsay Cloud предоставляет расшифровку речи и редактирование, без крупной модели для подготовки на этом Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть один раз. Plainsay Cloud надає розшифровку мовлення й редагування, без великої моделі для підготовки на цьому Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需登录一次。Plainsay Cloud 提供语音转录和清理功能，无需在这台 Mac 上准备大型模型。"
          }
        }
      }
    },
    "wizard.configure.detail.local": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfohlene mehrsprachige Modelle benötigen etwa 475–632 MB und können beim ersten Mal einige Minuten zum Herunterladen und Vorbereiten brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommended multilingual models need about 475–632 MB and can take several minutes to download and prepare the first time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos multilingües recomendados necesitan unos 475–632 MB y pueden tardar varios minutos en descargarse y prepararse la primera vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles multilingues recommandés nécessitent environ 475 à 632 Mo et peuvent prendre plusieurs minutes à télécharger et préparer la première fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli multilingue consigliati richiedono circa 475–632 MB e possono impiegare diversi minuti per essere scaricati e preparati la prima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推奨される多言語モデルは約475〜632MBで、初回のダウンロードと準備に数分かかる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권장하는 다국어 모델은 약 475~632MB이며, 처음 다운로드하고 준비하는 데 몇 분이 걸릴 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanbevolen meertalige modellen vereisen ongeveer 475–632 MB en kunnen de eerste keer enkele minuten duren om te downloaden en voor te bereiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalecane modele wielojęzyczne potrzebują około 475–632 MB i pobranie oraz przygotowanie może zająć kilka minut za pierwszym razem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos multilingues recomendados precisam de cerca de 475–632 MB e podem demorar vários minutos a transferir e preparar da primeira vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуемым многоязычным моделям нужно около 475–632 МБ, загрузка и подготовка в первый раз может занять несколько минут."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендованим багатомовним моделям потрібно близько 475–632 МБ, завантаження і підготовка вперше можуть тривати кілька хвилин."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐的多语言模型需要约 475–632 MB，首次下载和准备可能需要几分钟。"
          }
        }
      }
    },
