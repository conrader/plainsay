            "value": "Запись — продолжайте говорить ещё %d с…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис — продовжуйте говорити ще %d с…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在录音 — 请继续说话，还剩 %d 秒…"
          }
        }
      }
