    "After changing Accessibility or Input Monitoring, quit and reopen Plainsay so macOS applies the grant.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Änderungen an Bedienungshilfen oder Input Monitoring Plainsay beenden und neu öffnen, damit macOS die Freigabe übernimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After changing Accessibility or Input Monitoring, quit and reopen Plainsay so macOS applies the grant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de cambiar Accesibilidad o Monitorización de entrada, cierra y vuelve a abrir Plainsay para que macOS aplique el permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir modifié Accessibilité ou Surveillance des saisies, quittez et rouvrez Plainsay pour que macOS applique l'autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver modificato Accessibilità o Monitoraggio input, chiudi e riapri Plainsay perché macOS applichi il permesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティまたは入力監視の設定を変更したら、Plainsayを終了して再度開き、macOSに権限を適用させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 또는 입력 모니터링 설정을 변경한 후에는 Plainsay를 종료했다가 다시 열어야 macOS가 권한을 적용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit Plainsay af en open het opnieuw nadat je Toegankelijkheid of Invoermonitoring hebt gewijzigd, zodat macOS de toestemming toepast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zmianie uprawnień Dostępność lub Monitorowanie wejścia zamknij i ponownie otwórz Plainsay, aby macOS zastosował nadanie uprawnienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de alterar Acessibilidade ou Monitorização de Entrada, fecha e volta a abrir o Plainsay para o macOS aplicar a permissão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После изменения доступа в разделах «Универсальный доступ» или «Мониторинг ввода» закройте и снова откройте Plainsay, чтобы macOS применила разрешение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після зміни доступу в розділах «Універсальний доступ» або «Моніторинг вводу» закрийте і знову відкрийте Plainsay, щоб macOS застосувала дозвіл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改「辅助功能」或「输入监control」权限后，请退出并重新打开 Plainsay，让 macOS 应用新的授权。"
          }
        }
      }
    },
    "Auto-detecting across every language the model knows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Erkennung über alle Sprachen, die das Modell kennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-detecting across every language the model knows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectando automáticamente entre todos los idiomas que conoce el modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détection automatique parmi toutes les langues connues du modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevamento automatico tra tutte le lingue conosciute dal modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが知っているすべての言語を自動検出しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 아는 모든 언어를 자동으로 감지하고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecteert automatisch elke taal die het model kent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne wykrywanie spośród wszystkich języków znanych modelowi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A detetar automaticamente entre todos os idiomas que o modelo conhece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоопределение по всем языкам, которые знает модель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автовизначення за всіма мовами, які знає модель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在模型已知的所有语言中自动检测。"
          }
        }
      }
    },
    "Automatically check for updates": {
