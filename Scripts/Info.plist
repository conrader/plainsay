	<string>Plainsay records your voice while you hold the dictation hotkey, and transcribes it on this Mac.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Plainsay pastes transcribed text into the app you are using.</string>

	<key>NSHighResolutionCapable</key>
	<true/>
